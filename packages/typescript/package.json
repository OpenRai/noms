{
  "name": "@openrai/noms",
  "version": "0.1.1",
  "description": "Nano Off-chain Message Signing reference implementation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRai/noms.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "noms": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "test": "vitest run",
    "test:api": "tsc -p test/api/tsconfig.json",
    "release:patch": "pnpm version patch --tag-version-prefix npm-v --message \"release: @openrai/noms %s\"",
    "release:minor": "pnpm version minor --tag-version-prefix npm-v --message \"release: @openrai/noms %s\"",
    "release:major": "pnpm version major --tag-version-prefix npm-v --message \"release: @openrai/noms %s\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
