{
  "name": "noms-cli",
  "version": "0.1.0",
  "description": "Command-line interface for Nano Off-chain Message Signing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRai/noms.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "noms": "dist/cli.js",
    "noms-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test",
    "release:patch": "pnpm version patch --tag-version-prefix noms-cli-npm-v --message \"release: noms-cli %s\"",
    "release:minor": "pnpm version minor --tag-version-prefix noms-cli-npm-v --message \"release: noms-cli %s\"",
    "release:major": "pnpm version major --tag-version-prefix noms-cli-npm-v --message \"release: noms-cli %s\""
  },
  "dependencies": {
    "@openrai/noms": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
